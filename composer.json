{
  "name": "lotox/business-api",
  "description": "Laravel backend migration base for LotoX Business.",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "pestphp/pest": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "test": "php artisan test",
    "lint": "vendor/bin/pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
